{
  "name": "kpstechnology-web",
  "version": "1.0.0",
  "private": true,
  "description": "KPS Technology website and fleet management application",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build:frontend",
    "build:frontend": "npm --workspace frontend run build",
    "start": "node backend/src/server.js",
    "dev": "npm --workspace backend run dev",
    "seed": "npm --workspace backend run seed"
  }
}