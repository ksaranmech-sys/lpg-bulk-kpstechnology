{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/build",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://lpg-bulk-kpstechnology-fleet.onrender.com/health"
    },
    {
      "source": "/api/:path*",
      "destination": "https://lpg-bulk-kpstechnology-fleet.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}