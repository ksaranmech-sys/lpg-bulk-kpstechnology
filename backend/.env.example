# Server
PORT=5001
NODE_ENV=development
API_BASE_URL=http://localhost:5001

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/kps_fleet
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000
MONGO_CONNECT_TIMEOUT_MS=8000

# JWT - both secrets are REQUIRED (server refuses to start without them) and must differ.
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Browser origins allowed to call the API (comma-separated). Leave empty in local dev.
# Production example: ALLOWED_ORIGINS=https://lpg-bulk.kpstechnology.in,https://your-app.vercel.app
ALLOWED_ORIGINS=

# First-run only: password for the initial "kpsadmin" super admin. Used ONLY when no super admin
# exists yet (or with `npm run seed -- --reset-admin-password`). Remove after first login.
ADMIN_INITIAL_PASSWORD=
# Set to false to skip the first-run admin creation on startup.
AUTO_SEED=true

# Company (KPS Technology) settings
COMPANY_NAME=KPS Technology
COMPANY_EMAIL=office@kpstechnology.com

# Mail (SMTP) - used to send trip settlement reports
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password
MAIL_FROM="KPS Fleet <office@kpstechnology.com>"

# File storage
# "local"      = backend/uploads on disk (dev only - Render wipes the disk on every deploy)
# "cloudinary" = persistent hosted images (production). Free account at cloudinary.com;
#                copy the "API environment variable" from the dashboard into CLOUDINARY_URL.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
CLOUDINARY_URL=
CLOUDINARY_FOLDER=kps-fleet
