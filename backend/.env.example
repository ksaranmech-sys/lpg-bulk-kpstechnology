# Server
PORT=5001
NODE_ENV=development
API_BASE_URL=http://localhost:5001

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/kps_fleet
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000
MONGO_CONNECT_TIMEOUT_MS=8000

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_too_to_a_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# Company (KPS Technology) settings
COMPANY_NAME=KPS Technology
COMPANY_EMAIL=office@kpstechnology.com

# Mail (SMTP) - used to send trip settlement reports
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password
MAIL_FROM="KPS Fleet <office@kpstechnology.com>"

# File storage
# Set to "local" for disk storage (dev) or "s3" for production (recommended so the
# mobile app and web app both get stable CDN/S3 URLs for photos).
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# AWS S3 (only needed if STORAGE_DRIVER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=kps-fleet-photos
