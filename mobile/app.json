{
  "expo": {
    "name": "LPG Fleet Driver",
    "slug": "lpg-fleet-driver",
    "scheme": "lpgfleet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.kpstechnology.lpgfleet",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.kpstechnology.lpgfleet",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "LPG Fleet Driver uses the camera to photograph diesel, RTO and expense receipts.",
          "photosPermission": "LPG Fleet Driver needs photo access to attach receipt images.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LPG Fleet Driver records your location when you log a diesel fill so the trip report shows where it happened."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://lpg-bulk-kpstechnology-fleet.onrender.com/api/v1",
      "router": {},
      "eas": {
        "projectId": "870bb448-97a7-441a-9f26-91210a364026"
      }
    },
    "owner": "kpstechnology"
  }
}
