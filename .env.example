# Copy this file to .env and fill in real values before starting the server

PORT=4000

# Long random string used to sign login tokens. Change this to any long random text.
JWT_SECRET=change_this_to_a_long_random_secret_string

# SMTP settings used to send trip reports and expiry reminder emails.
# Example values for a Gmail account using an "App Password":
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_company_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="KPS Technology <your_company_email@gmail.com>"

# Default super-admin account created the first time the database is initialised.
SUPERADMIN_USERNAME=kpsadmin
SUPERADMIN_PASSWORD=ChangeMe@123
